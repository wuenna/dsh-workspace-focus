{
  "name": "dsh-workspace-focus",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: an eye toggle beside the sidebar's search / view-options / add-workspace buttons that hides every workspace except the one holding the current session.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "sidebar",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuenna/dsh-workspace-focus.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
